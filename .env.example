# Kopieer dit bestand naar .env en vul de waarden in.

# --- Server ---------------------------------------------------------------
PORT=3000
# Wachtwoord voor het dashboard (gebruikersnaam: ADMIN_USER). Altijd instellen op een server!
ADMIN_USER=admin
ADMIN_PASSWORD=
# DB_FILE=./data/voorraad.db

# --- Bol.com Retailer API ---------------------------------------------------
# Partnerplatform → Instellingen → API-instellingen → Retailer API → "Credentials aanmaken"
BOL_CLIENT_ID=
BOL_CLIENT_SECRET=
# FBR = je verstuurt zelf (voorraad uit eigen magazijn). Gebruik ALL om ook FBB mee te tellen.
BOL_FULFILMENT_METHOD=FBR
# Hoe vaak nieuwe/gewijzigde Bol-orders worden opgehaald (seconden).
BOL_POLL_INTERVAL_SECONDS=60
# BOL_API_VERSION=v10

# --- WooCommerce (eigen webshop) --------------------------------------------
# WooCommerce → Instellingen → Geavanceerd → REST API → "Sleutel toevoegen" (Lezen/Schrijven)
WOO_BASE_URL=https://tochtstripdeur.nl
WOO_CONSUMER_KEY=
WOO_CONSUMER_SECRET=
# WooCommerce → Instellingen → Geavanceerd → Webhooks: hetzelfde geheim invullen bij elke webhook
WOO_WEBHOOK_SECRET=
# Vangnet voor gemiste webhooks: recent gewijzigde orders opnieuw ophalen (seconden).
WOO_POLL_INTERVAL_SECONDS=300
# Zet op true als een terugbetaalde order de artikelen weer op voorraad moet zetten.
WOO_RESTOCK_ON_REFUND=false

# --- Voorspelling -------------------------------------------------------------
# Standaardperiode voor de gemiddelde verkoop per dag (7, 14, 30, 60 of 90).
FORECAST_WINDOW_DAYS=30
# Hoeveel dagen verkoop een besteladvies moet dekken (bovenop levertijd + marge).
REORDER_COVER_DAYS=60

# --- Demo ---------------------------------------------------------------------
# true = geen echte API-aanroepen, gesimuleerde orders (gebruik: npm run demo)
DEMO_MODE=false
