# Kopieer dit bestand naar .env en vul de waarden in.

# --- Server ---------------------------------------------------------------
PORT=3000
# Webadres van het dashboard (alleen nodig bij docker-compose met automatische HTTPS).
DOMAIN=voorraad.tochtstripdeur.nl
# DB_FILE=./data/voorraad.db        (gebruikers en webshop-instellingen)
# SHOPS_DIR=./data/webshops         (één database per webshop)
# Achter een proxy / hostingplatform dat HTTPS afhandelt: true
TRUST_PROXY=false
# Dagelijkse back-up van de database; zoveel dagen bewaren.
# BACKUP_DIR=./data/backups
BACKUP_KEEP_DAYS=14

# --- Eerste beheerder ---------------------------------------------------------
# Wordt bij de eerste start aangemaakt als er nog geen gebruikers zijn.
# Collega's voegt u daarna toe in het dashboard (menu rechtsboven → Gebruikers beheren).
ADMIN_EMAIL=
ADMIN_NAME=
# Minimaal 10 tekens. Na de eerste start mag deze regel weer leeg.
ADMIN_PASSWORD=

# --- Webshops ----------------------------------------------------------------
# Webshops (WooCommerce- en Bol.com-sleutels) voegt u toe in het dashboard:
# menu rechtsboven → Webshops beheren. De sleutels worden versleuteld opgeslagen met:
SECRET_KEY=
# (Een lange willekeurige tekst. Bewaar hem goed: zonder deze sleutel zijn de
#  opgeslagen API-sleutels onleesbaar. Leeg = er wordt een sleutelbestand aangemaakt.)

# Instellingen die voor alle webshops gelden:
# Hoe vaak nieuwe/gewijzigde Bol-orders worden opgehaald (seconden).
BOL_POLL_INTERVAL_SECONDS=60
# Vangnet voor gemiste WooCommerce-webhooks: recent gewijzigde orders opnieuw ophalen (seconden).
WOO_POLL_INTERVAL_SECONDS=300
# Zet op true als een terugbetaalde order de artikelen weer op voorraad moet zetten.
WOO_RESTOCK_ON_REFUND=false

# --- Voorspelling -------------------------------------------------------------
# Standaardperiode voor de gemiddelde verkoop per dag (7, 14, 30, 60 of 90).
FORECAST_WINDOW_DAYS=30
# Hoeveel dagen verkoop een besteladvies moet dekken (bovenop levertijd + marge).
REORDER_COVER_DAYS=60

# --- Demo ---------------------------------------------------------------------
# true = geen echte API-aanroepen, gesimuleerde orders (gebruik: npm run demo)
DEMO_MODE=false
